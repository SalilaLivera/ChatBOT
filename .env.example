# MaternaLink — local development environment.
# Copy to .env (untracked, gitignored) and fill in real values.
# No secret and no fusion parameter belongs in this file (standing rule 3, §7A.7).

# --- backend ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

FER_SERVICE_URL=http://fer:7860
SENTIMENT_SERVICE_URL=http://sentiment:8000
FUSION_SERVICE_URL=http://fusion:9000

# PROVISIONAL — FER end-to-end latency and all sentiment latency are UNKNOWN
# (handoff §7.1, §13). Set for real in C8.3.
FER_TIMEOUT_MS=3000
SENTIMENT_TIMEOUT_MS=15000
FUSION_TIMEOUT_MS=1000

LANGUAGE_POLICY=face_only

DATABASE_URL=postgres://maternalink:changeme@postgres:5432/maternalink
JWT_SECRET=change-me-to-a-real-secret

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- postgres ---
POSTGRES_USER=maternalink
POSTGRES_PASSWORD=changeme
POSTGRES_DB=maternalink

# --- fer / sentiment (off in production; off here too by default) ---
FER_DEBUG=0
SENTIMENT_DEBUG=0
