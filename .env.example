# MaternaLink — local development environment.
# Copy to .env (untracked, gitignored) and fill in real values.
# No secret and no fusion parameter belongs in this file (standing rule 3, §7A.7).

# --- backend ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

FER_SERVICE_URL=http://fer:7860
SENTIMENT_SERVICE_URL=http://sentiment:8000
FUSION_SERVICE_URL=http://fusion:9000

# PROVISIONAL — FER end-to-end latency and all sentiment latency are UNKNOWN
# (handoff §7.1, §13). Set for real in C8.3.
FER_TIMEOUT_MS=3000
SENTIMENT_TIMEOUT_MS=15000
FUSION_TIMEOUT_MS=1000

LANGUAGE_POLICY=face_only

# --- C5 language ratio bounds (C5_PLAN.md §2) ---
# ✅ SIGNED by the project owner, 2026-08-30. Values unchanged (LOW=0.1,
# HIGH=0.6). Full text of the provenance lives in LANGUAGE_BOUNDS_PROPOSAL.md
# (§ "Owner sign-off, 2026-08-30") — this is a short signed marker pointing at
# it, not a paraphrase to rely on standalone.
LANGUAGE_SI_RATIO_HIGH=0.6
LANGUAGE_SI_RATIO_LOW=0.1
LANGUAGE_BOUNDS_PROVENANCE=SIGNED by the project owner, 2026-08-30 — judgement not measurement; mixed is pending the ML track's ratio-sweep diagnostic; full text in LANGUAGE_BOUNDS_PROPOSAL.md

DATABASE_URL=postgres://maternalink:changeme@postgres:5432/maternalink

# --- C7 — Supabase Anonymous Authentication ---
# This backend is NOT a JWT issuer. JWT_SECRET is the SUPABASE PROJECT's JWT
# secret (Supabase dashboard: Project Settings → API → JWT Secret) — used
# ONLY to verify a token Supabase already issued (HS256). Never defaulted,
# never logged. Missing/blank here means every authenticated request fails
# closed (401), never a shared/demo identity.
SUPABASE_URL=https://<your-project-ref>.supabase.co

# --- C7 Part C — rate limiting ---
# ✅ OWNER-DECIDED PROVISIONAL ENGINEERING LIMITS (C7_DECISIONS_AND_GAPS.md
# §5.1) — NOT ML measurements, NOT a production-capacity claim. The face
# figure is the minimum permitting the specified 5 fps capture (300
# frames/min/user, §3A.6) without throttling a correct client.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_FACE_PER_MIN=300
RATE_LIMIT_TEXT_PER_MIN=60
RATE_LIMIT_IP_PER_MIN=600

# --- C7 Part B / D-40 — mood observation retention ---
# ✅ OWNER-DECIDED (§5.3) — a project/engineering retention decision, NOT a
# clinical claim. Historical face-derived observations are NOT deleted by
# consent revocation (prospective-only, §1 of C7_DECISIONS_AND_GAPS.md) —
# they age out under this policy instead.
MOOD_OBSERVATION_RETENTION_DAYS=30

# --- postgres ---
POSTGRES_USER=maternalink
POSTGRES_PASSWORD=changeme
POSTGRES_DB=maternalink

# --- fer / sentiment / fusion (off in production; off here too by default) ---
FER_DEBUG=0
SENTIMENT_DEBUG=0
FUSION_DEBUG=0

# --- fusion parameters (C4_PLAN.md §3.2) ---
# ⛔ THESE ARE PLACEHOLDERS — NOT MEASUREMENTS, NOT ESTIMATES, NOT PROPOSALS
# TO PHASE 7. They exist only so integration can proceed before the Phase 7
# weight-sensitivity experiment produces real values (C9). This is the
# supervisor-specified development placeholder set (C4_PLAN.md §3.2), stated
# explicitly here rather than invented, per §8.3. Until C9 replaces them, no
# mood output from this system may be presented as a measured result.
#
# W_face deliberately avoids 0.50-0.60: the weight-sensitivity sweep found
# the fused state flips inside that band when the modalities disagree, so a
# placeholder there would produce demo behaviour maximally unrepresentative
# of whatever the measured value turns out to be. 0.35 is not "more
# correct" — no value is correct until Phase 7.
FUSION_W_FACE=0.35
FUSION_W_TEXT=0.65
FUSION_TAU_FACE_MIN=0.30
FUSION_TAU_TEXT_MIN=0.30
FUSION_TAU_FUSION_MIN=0.30
FUSION_TAU_DISTRESS=0.60
FUSION_PARAM_PROVENANCE=PLACEHOLDER FOR TESTING - NOT A MEASURED VALUE

# --- llm (M7) ---
# ⛔ D-6 GATE. LLM_PROVIDER MUST REMAIN 'mock' until D-6 — whether
# pregnancy-domain user messages may be sent to a third-party US inference
# provider — is resolved. It is a privacy and ethics decision, not a
# configuration one. 'mock' makes no network call of any kind.
#
# Setting this to 'groq' additionally requires GROQ_API_KEY and LLM_MODEL.
# Neither has a default, so no default configuration can reach a network.
LLM_PROVIDER=mock

# ⛔ SERVER-SIDE ONLY. Never returned in a response, never logged, never
# exposed in /health. LEAVE EMPTY HERE — a key in a committed example file is
# a leaked key. Possessing a key is capability, not approval: it does not
# open the D-6 gate on its own.
GROQ_API_KEY=

# Pin the model explicitly. Free-tier model IDs are deprecated with little
# notice, and a silent swap must be visible rather than inferred — /health
# reports whatever is set here.
LLM_MODEL=

LLM_TIMEOUT_MS=20000
LLM_MAX_OUTPUT_TOKENS=800

# D-9 (conversation history, docs/integration/plan/D7_HISTORY_PLAN.md) —
# number of prior USER/ASSISTANT PAIRS included in the LLM request. A
# starting, unmeasured number, not a token-budget calculation. 0 means
# history is fetched but always empty (today's single-turn behaviour).
LLM_HISTORY_TURNS=3

# --- follow-up packet 3, step 3 — CORS ---
# Explicit origin ALLOWLIST, comma-separated. ⛔ Never *. Add the deployed
# Vercel domain(s) alongside (not instead of) the two Expo web localhost
# ports shown here.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082

# --- follow-up packet 3, step 4 (D-42) — /ready deployment posture ---
# ⛔ GOVERNANCE. strict | research_demo. DEFAULT: strict — an unset value
# fails closed to the original §8.2 behaviour (503 while fusion parameters
# are placeholder). `research_demo` is ONLY for the demo deployment: it lets
# /ready report 200 with an explicit `limitations` array while parameters are
# still placeholder-derived. It does NOT relax any other guard (NODE_ENV
# still governs those) and it does NOT excuse a broken upstream — a
# fer/sentiment/fusion outage still returns 503 under research_demo too. See
# C7_DECISIONS_AND_GAPS.md D-42.
DEPLOYMENT_POSTURE=strict
